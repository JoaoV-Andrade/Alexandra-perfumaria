# Supabase — em supabase.com/dashboard, vá no seu projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service role) — NUNCA usar no navegador, só em código de servidor
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp da loja para receber pedidos (DDI + DDD + número, só dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Melhor Envio — token de PRODUÇÃO gerado no painel (Área Dev > Aplicações >
# Gerar novo Token), com escopo "shipping-calculate". A loja só cota Correios
# (PAC e SEDEX); a postagem é sempre feita manualmente na agência, então não
# usamos carrinho nem compra de etiqueta do Melhor Envio.
MELHORENVIO_TOKEN=

# E-mail de contato exigido pelo Melhor Envio no header User-Agent de toda
# requisição (sem ele a API rejeita a chamada).
MELHORENVIO_USER_AGENT_EMAIL=

# CEP de onde os produtos são enviados (só dígitos) — nunca vem do navegador.
CEP_ORIGEM=

# Asaas — app.asaas.com > Integrações > Chaves de API. Chave de PRODUÇÃO
# (começa com $aact_prod_); a conta precisa estar verificada/aprovada pelo
# Asaas antes da chave funcionar.
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=production

# Token de autenticação do webhook — você mesmo escolhe essa string (32+
# caracteres aleatórios) e cadastra ela ao criar o webhook no painel/API do
# Asaas, apontando para https://SEU-SITE/api/webhooks/asaas. O Asaas devolve
# esse mesmo valor no header "asaas-access-token" de toda notificação.
ASAAS_WEBHOOK_TOKEN=

# URL pública do site, sem barra no final (ex.: https://alexandraperfumaria.vercel.app
# em produção, ou uma URL do ngrok/túnel ao testar localmente — o Asaas
# precisa acessar essa URL para enviar a notificação de pagamento).
NEXT_PUBLIC_SITE_URL=
