# Supabase — em supabase.com/dashboard, vá no seu projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service role) — NUNCA usar no navegador, só em código de servidor
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp da loja para receber pedidos (DDI + DDD + número, só dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Melhor Envio — token gerado no painel (Área Dev). "sandbox" para testes,
# "production" quando a loja estiver pronta para valer.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENVIRONMENT=sandbox

# CEP de onde os produtos são enviados (só dígitos)
STORE_ORIGIN_POSTAL_CODE=

# Mercado Pago Checkout Pro — painel do desenvolvedor > Suas integrações >
# credenciais > aba "Credenciais de teste". Use o Access Token de teste por
# enquanto; troque para o de produção (e mude MERCADO_PAGO_ENVIRONMENT abaixo)
# só quando eu pedir.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ENVIRONMENT=sandbox

# Chave secreta do webhook — painel do desenvolvedor > sua aplicação >
# Webhooks > URLs de produção/teste. Aparece só depois de cadastrar a URL
# https://SEU-SITE/api/webhooks/mercadopago lá (evento "Pagamentos").
MERCADO_PAGO_WEBHOOK_SECRET=

# URL pública do site, sem barra no final (ex.: https://alexandraperfumaria.vercel.app
# em produção, ou uma URL do ngrok/túnel ao testar localmente — o Mercado
# Pago precisa acessar essa URL para enviar a notificação de pagamento).
NEXT_PUBLIC_SITE_URL=
